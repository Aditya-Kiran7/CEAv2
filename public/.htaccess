# CEA website — SPA routing (ROOT deploy: https://yourdomain.com/)
# Files in public/ are copied into build/ automatically by `yarn build`,
# so this ships with your build. If you deploy under a SUBFOLDER (e.g.
# yourdomain.com/cea/), replace the contents with .htaccess-subfolder-cea.
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /
  RewriteRule ^index\.html$ - [L]
  RewriteCond %{REQUEST_FILENAME} !-f
  RewriteCond %{REQUEST_FILENAME} !-d
  RewriteRule . /index.html [L]
</IfModule>
